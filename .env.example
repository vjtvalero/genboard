# Copy to .env (gitignored) and fill in. Sensitive values are left blank.

# NextAuth (generate AUTH_SECRET with: npx auth secret)
AUTH_SECRET=
AUTH_GITHUB_ID=                   # GitHub OAuth App → Client ID
AUTH_GITHUB_SECRET=               # GitHub OAuth App → Client secret

# Prisma (SQLite). Absolute path recommended on Windows.
DATABASE_URL="file:C:/Users/<you>/.genboard/genboard.db"

# AI — these seed the first run; the active provider/model/effort is stored in
# ~/.genboard/ai-config.json and changed from the top-nav switcher.
AI_PROVIDER=claude-cli            # claude-api | openai | google | claude-cli | codex | agy
AI_CLAUDE_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=                # for provider "claude-api"
OPENAI_API_KEY=                   # for provider "openai"
GOOGLE_GENERATIVE_AI_API_KEY=     # for provider "google"
# claude-cli / codex / agy use their own CLI login — no key here.

# File enumeration limits (optional; defaults applied if unset)
GENBOARD_MAX_FILES=400
GENBOARD_MAX_FILE_BYTES=100000
GENBOARD_MAX_TOTAL_BYTES=2000000
